diff --git a/evodm/test/test_mismatch_eval.py b/evodm/test/test_mismatch_eval.py
new file mode 100644
index 0000000..1cef7b1
--- /dev/null
+++ b/evodm/test/test_mismatch_eval.py
@@ -0,0 +1,116 @@
+"""Tests for the mismatched-staleness observation and the greedy evaluation."""
+import numpy as np
+import pytest
+from evodm import evol_env, define_mira_landscapes, evol_deepmind
+from evodm.evaluate import greedy_eval, reference_eval
+
+N, K = 4, 15
+
+
+def make_env(mode, w):
+    return evol_env(N=N, num_drugs=K, drugs=define_mira_landscapes(), train_input=mode,
+                    obs_delay=w, add_noise=False, normalize_drugs=False)
+
+
+def onehot(a):
+    v = np.zeros(K)
+    v[a - 1] = 1.0
+    return v
+
+
+def play(env, actions):
+    for a in actions:
+        env.action = a
+        env.step()
+
+
+def window(env):
+    return env.build_obs()[16:].reshape(-1, K)
+
+
+def test_default_staleness_equals_window_length():
+    env = make_env("delayed_history", 3)
+    assert env.OBS_STALE == env.OBS_DELAY == 3
+
+
+def test_staler_than_trained_drops_oldest_drugs():
+    env = make_env("delayed_history", 2)          # network built for a window of 2
+    play(env, [3, 5, 7, 9])                       # t = 4 actions taken
+    env.OBS_STALE = 3                             # reading is 3 steps old, window holds only 2
+    obs = env.build_obs()
+    assert np.allclose(obs[:16], env.state_hist[1])        # stale state s_1
+    w = window(env)
+    assert w.shape == (2, K)
+    assert np.allclose(w[0], onehot(7)) and np.allclose(w[1], onehot(9))  # a_3, a_4; a_2 (=5) dropped
+    assert obs.shape == env.ENVIRONMENT_SHAPE
+
+
+def test_fresher_than_trained_pads_with_zeros():
+    env = make_env("delayed_history", 3)
+    play(env, [3, 5, 7, 9])
+    env.OBS_STALE = 1                             # reading is only 1 step old
+    obs = env.build_obs()
+    assert np.allclose(obs[:16], env.state_hist[3])        # stale state s_3
+    w = window(env)
+    assert w.shape == (3, K)
+    assert np.allclose(w[0], 0) and np.allclose(w[1], 0) and np.allclose(w[2], onehot(9))
+
+
+def test_zero_staleness_has_empty_window():
+    env = make_env("delayed_history", 2)
+    play(env, [3, 5])
+    env.OBS_STALE = 0
+    obs = env.build_obs()
+    assert np.allclose(obs[:16], np.array(env.state_vector).ravel())
+    assert np.allclose(window(env), 0)
+
+
+def test_decoy_window_has_one_random_drug_per_real_slot():
+    env = make_env("delayed_decoy", 3)
+    play(env, [3, 5, 7])
+    env.OBS_STALE = 2
+    w = window(env)
+    assert w.sum() == 2 and (w.sum(axis=1) <= 1).all()
+
+
+def test_state_mode_shape_is_unchanged_by_staleness():
+    env = make_env("delayed_state", 2)
+    play(env, [3, 5, 7])
+    for k in range(5):
+        env.OBS_STALE = k
+        assert env.build_obs().shape == (16,)
+
+
+@pytest.fixture(scope="module")
+def trained():
+    return evol_deepmind(episodes=3, N=N, num_drugs=K, mira=True,
+                         train_input="delayed_history", obs_delay=2, train_freq=1)
+
+
+def test_greedy_eval_runs_and_restores_agent(trained):
+    agent = trained[2]
+    n_before, eps_before, mem_before = agent.hp.EPISODES, agent.hp.epsilon, len(agent.master_memory)
+    fit = greedy_eval(agent, stale=3, episodes=2)
+    assert fit.shape == (2,) and np.isfinite(fit).all() and (fit >= 0).all()
+    assert agent.hp.EPISODES == n_before and agent.hp.epsilon == eps_before
+    assert len(agent.master_memory) == mem_before and agent.env.OBS_STALE == 2
+
+
+def test_greedy_eval_does_not_change_weights(trained):
+    agent = trained[2]
+    before = [w.copy() for w in agent.model.get_weights()]
+    greedy_eval(agent, stale=1, episodes=2)
+    assert all(np.array_equal(a, b) for a, b in zip(before, agent.model.get_weights()))
+
+
+def test_stale_rejected_outside_delayed_modes():
+    out = evol_deepmind(episodes=2, N=N, num_drugs=K, mira=True, train_input="state_vector", train_freq=1)
+    with pytest.raises(ValueError):
+        greedy_eval(out[2], stale=2, episodes=1)
+
+
+def test_reference_policies_evaluate(trained):
+    naive = reference_eval(trained[3], "naive", episodes=2)
+    dp = reference_eval(trained[4], "dp", episodes=2)
+    assert naive.shape == (2,) and dp.shape == (2,)
+    assert dp.mean() <= naive.mean() + 0.3  # exact optimum is not worse than random beyond noise
diff --git a/run_experiment.py b/run_experiment.py
new file mode 100644
index 0000000..800e3b0
--- /dev/null
+++ b/run_experiment.py
@@ -0,0 +1,102 @@
+"""Run one experiment from a configuration file.
+
+usage: python run_experiment.py configs/main/main_history_d2_s10.json [--force]
+
+Config keys: id, mode (repo | state | history | decoy), delay, seed, episodes, train_freq,
+eval_episodes, eval_stale (list; ignored for mode repo).
+
+Writes, under results/raw/:
+  <id>.csv          per-episode mean fitness during training (columns episode, RL, naive, DP)
+  <id>_eval.csv     greedy evaluation on fresh episodes (policy, test_stale, episode, fitness)
+  <id>_record.json  config, git commit, software versions, hardware, compute time, summary
+A run whose record already exists is skipped unless --force is given.
+"""
+import json, os, platform, random, subprocess, sys, time
+from datetime import datetime, timezone
+
+import numpy as np
+import pandas as pd
+import tensorflow as tf
+
+from evodm.exp import evol_deepmind
+from evodm.evaluate import per_episode, greedy_eval, reference_eval
+
+MODES = ("repo", "state", "history", "decoy")
+
+
+def git(*args):
+    try:
+        return subprocess.check_output(["git", *args], stderr=subprocess.DEVNULL).decode().strip()
+    except Exception:
+        return "unknown"
+
+
+def main(path, force=False):
+    cfg = json.load(open(path))
+    rid, mode = cfg["id"], cfg["mode"]
+    if mode not in MODES:
+        sys.exit("mode must be one of %s" % (MODES,))
+    out = "results/raw"
+    os.makedirs(out, exist_ok=True)
+    if os.path.exists(f"{out}/{rid}_record.json") and not force:
+        print("already done:", rid)
+        return
+
+    seed = int(cfg["seed"])
+    random.seed(seed); np.random.seed(seed); tf.random.set_seed(seed)
+    delay = int(cfg.get("delay", 0))
+    kw = dict(episodes=int(cfg["episodes"]), N=int(cfg.get("N", 4)),
+              num_drugs=int(cfg.get("num_drugs", 15)), mira=True,
+              train_freq=int(cfg["train_freq"]))
+    if mode == "repo":
+        kw.update(train_input="state_vector", delay=delay)
+    else:
+        kw.update(train_input="delayed_" + mode, obs_delay=delay, delay=0)
+
+    start = datetime.now(timezone.utc).isoformat(timespec="seconds")
+    t0 = time.time()
+    res = evol_deepmind(**kw)
+    agent, naive_agent, dp_agent = res[2], res[3], res[4]
+    train = {"RL": per_episode(agent), "naive": per_episode(naive_agent), "DP": per_episode(dp_agent)}
+    n = min(len(v) for v in train.values())
+    df = pd.DataFrame({k: v[:n] for k, v in train.items()})
+    df.index.name = "episode"
+    df.to_csv(f"{out}/{rid}.csv")
+    t_train = time.time() - t0
+
+    # greedy evaluation on fresh episodes (no exploration, no learning)
+    t1 = time.time()
+    n_eval = int(cfg.get("eval_episodes", 100))
+    rows = []
+    stales = [None] if mode == "repo" else list(cfg.get("eval_stale", [delay]))
+    for s in stales:
+        fit = greedy_eval(agent, stale=s, episodes=n_eval)
+        rows += [("RL", "train" if s is None else s, i, float(f)) for i, f in enumerate(fit)]
+    for name, ag, kind in (("naive", naive_agent, "naive"), ("DP", dp_agent, "dp")):
+        fit = reference_eval(ag, kind, episodes=n_eval)
+        rows += [(name, "NA", i, float(f)) for i, f in enumerate(fit)]
+    ev = pd.DataFrame(rows, columns=["policy", "test_stale", "episode", "fitness"])
+    ev.to_csv(f"{out}/{rid}_eval.csv", index=False)
+    t_eval = time.time() - t1
+
+    summary = {f"{p}_stale{s}": round(float(g.fitness.mean()), 4)
+               for (p, s), g in ev.groupby(["policy", "test_stale"])}
+    summary["train_last50_RL"] = round(float(df.RL.values[-50:].mean()), 4)
+    record = {
+        "id": rid, "config": cfg, "started_utc": start,
+        "seconds_train": round(t_train, 1), "seconds_eval": round(t_eval, 1),
+        "git_commit": git("rev-parse", "HEAD"),
+        "git_dirty": bool(git("status", "--porcelain", "--untracked-files=no")),
+        "python": platform.python_version(), "tensorflow": tf.__version__,
+        "numpy": np.__version__, "pandas": pd.__version__,
+        "platform": platform.platform(), "machine": platform.machine(),
+        "cpu_count": os.cpu_count(), "summary": summary,
+    }
+    json.dump(record, open(f"{out}/{rid}_record.json", "w"), indent=2)
+    print(rid, summary, "train s:", record["seconds_train"], "eval s:", record["seconds_eval"])
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        sys.exit(__doc__)
+    main(sys.argv[1], force="--force" in sys.argv)
diff --git a/scripts/make_configs.py b/scripts/make_configs.py
new file mode 100644
index 0000000..427b5d7
--- /dev/null
+++ b/scripts/make_configs.py
@@ -0,0 +1,31 @@
+"""Write the configuration file for every experiment in the paper to configs/main/.
+
+Design (frozen before the main runs): Dense network, 500 episodes, train_freq=1, untuned
+hyperparameters identical for every condition. Seeds 10-14 for all conditions; seeds 15-17 are
+added for the delay-2 conditions only (decided in advance, not after seeing results).
+The repository's own agent (mode repo, Conv1D, no delay) is run at the same budget as the
+matched-budget reproduction.
+"""
+import json, os
+
+OUT = "configs/main"
+EPISODES, TRAIN_FREQ, EVAL_EPISODES, EVAL_STALE = 500, 1, 50, [0, 1, 2, 3, 4]
+os.makedirs(OUT, exist_ok=True)
+
+conditions = [("state", 0)]
+for d in (1, 2, 3):
+    conditions += [("state", d), ("history", d), ("decoy", d)]
+
+def write(mode, d, s):
+    rid = f"main_{mode}_d{d}_s{s}"
+    cfg = dict(id=rid, mode=mode, delay=d, seed=s, episodes=EPISODES, train_freq=TRAIN_FREQ,
+               eval_episodes=EVAL_EPISODES, eval_stale=EVAL_STALE)
+    json.dump(cfg, open(f"{OUT}/{rid}.json", "w"), indent=2)
+
+for mode, d in conditions:
+    seeds = range(10, 18) if d == 2 else range(10, 15)
+    for s in seeds:
+        write(mode, d, s)
+for s in range(10, 15):
+    write("repo", 0, s)
+print(len(os.listdir(OUT)), "config files in", OUT)
diff --git a/scripts/run_all.sh b/scripts/run_all.sh
new file mode 100755
index 0000000..44e92cd
--- /dev/null
+++ b/scripts/run_all.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# usage: scripts/run_all.sh [config_dir] [parallel_jobs]
+# Runs every config in the directory, 4 at a time by default. Finished runs are skipped,
+# so the script can be stopped and restarted. One log per run in logs/.
+dir=${1:-configs/main}
+jobs=${2:-4}
+mkdir -p logs
+# seed order, so an interrupted batch still has every condition at fewer seeds
+ls "$dir"/*.json | sed 's/.*_s\([0-9]*\)\.json$/\1 &/' | sort -n | cut -d" " -f2 | xargs -P "$jobs" -I{} sh -c 'python run_experiment.py {} > logs/$(basename {} .json).log 2>&1'
+echo ALL DONE
